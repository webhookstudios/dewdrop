[Desktop Entry]
Type=Application
Name=Dewdrop
GenericName=Screenshot Tool
Comment=Take screenshots and mark them up with arrows, boxes, steps and blur
Exec=@EXEC@ %F
Icon=@ICON@
Terminal=false
StartupNotify=true
Categories=Graphics;Utility;GTK;
Keywords=snip;sedge;screenshot;capture;snip;annotate;arrow;blur;pin;greenshot;
MimeType=image/png;image/jpeg;
StartupWMClass=io.github.webhookstudios.Snip
Actions=area;window;screen;all;

[Desktop Action area]
Name=Capture Area
Exec=@EXEC@ --area

[Desktop Action window]
Name=Capture Window
Exec=@EXEC@ --window

[Desktop Action screen]
Name=Capture Screen
Exec=@EXEC@ --screen

[Desktop Action all]
Name=Capture All Screens
Exec=@EXEC@ --all
